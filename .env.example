# Strava API application ID from the API settings page
STRAVA_CLIENT_ID=123456

# Strava API application secret from the API settings page
STRAVA_CLIENT_SECRET=your_strava_client_secret_here

# Initial refresh token for database bootstrapping. Strava rotates refresh tokens and invalidates the old one immediately, so after the first successful refresh the `strava_auth` table is authoritative and this value goes stale. It exists to bootstrap a fresh database.
STRAVA_REFRESH_TOKEN=your_initial_refresh_token_here

# Arbitrary string chosen by you; echoed back during webhook subscription handshake to prove the callback is yours
STRAVA_VERIFY_TOKEN=your_verify_token_here

# The subscription ID returned when the webhook subscription is created; used to validate incoming Strava events
STRAVA_SUBSCRIPTION_ID=123456789

# Your Strava athlete ID, printed by `npm run strava:auth`; the webhook compares it against each event's owner_id to reject events for other athletes
STRAVA_ATHLETE_ID=12345678

# Supabase Postgres connection string (use the pooled/session connection string, not the direct one)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Bearer token sent by Vercel on scheduled cron invocations; the cron route rejects requests without it
CRON_SECRET=your_cron_secret_here
